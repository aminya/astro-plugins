{
  "name": "astro-plugins",
  "version": "1.4.5",
  "private": true,
  "description": "Various astro plugins such as astro-htmlnano to minify Astro files with HTMLNano and CSSNano",
  "keywords": [
    "parcel",
    "astro",
    "astro-parcel",
    "astrobuild",
    "parceljs",
    "build",
    "bundle",
    "plugin",
    "html",
    "posthtml",
    "relative",
    "relative-path",
    "path",
    "root",
    "url",
    "relative-attribute",
    "attribute"
  ],
  "homepage": "https://github.com/aminya/astro-plugins",
  "repository": "https://github.com/aminya/astro-plugins",
  "license": "Apache-2.0",
  "author": "Amin Yahyaabadi",
  "type": "module",
  "workspaces": [
    "./packages/*",
    "./test"
  ],
  "scripts": {
    "build": "bun '--filter=./packages/*' run build",
    "bump": "ncu -u && bun '--filter=./packages/*' run bump && bun update",
    "clean": "shx rm -rf ./packages/*/dist/ ./test/dist/ ./test/.astro",
    "doc": "bun '--filter=./packages/*' run doc && bun run format",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "prepare": "bun run build",
    "publish": "bun run publish",
    "test": "run-p test.cspell test.lint && run-s test.posthtml test.htmlnano",
    "test.cspell": "cspell lint --no-progress --show-suggestions",
    "test.format": "prettier . --check",
    "test.htmlnano": "run-s clean build && cd test && cross-env NODE_ENV=production TEST=htmlnano bun run build",
    "test.lint": "eslint .",
    "test.posthtml": "run-s clean build && cd test && cross-env NODE_ENV=production TEST=posthtml bun run build"
  },
  "prettier": "prettier-config-atomic",
  "overrides": {
    "sort-package-json": "3.6.1"
  },
  "devDependencies": {
    "@types/node": "22.13.14",
    "cross-env": "^7.0.3",
    "cspell": "8.18.0",
    "eslint": "^8",
    "eslint-config-atomic": "1.22.1",
    "npm-check-updates": "17.1.16",
    "npm-run-all2": "7.0.2",
    "prettier": "3.5.3",
    "prettier-config-atomic": "4.0.0",
    "readme-md-generator": "1.0.0",
    "shx": "0.4.0",
    "ts-readme": "1.1.3",
    "typescript": "5.8.2",
    "typesync": "0.14.1"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "node": ">=16"
  }
}
